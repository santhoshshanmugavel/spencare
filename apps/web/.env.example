# Spencare -- environment variable reference (Phase 21).
#
# Copy this file to .env.local for local development (`npx supabase start`
# prints the matching local values). NEVER commit a file containing real
# secrets -- only this placeholder file is tracked in git (see the
# `!.env.example` negation in .gitignore).
#
# Every variable below is either:
#   PUBLIC      -- safe to ship in the client JS bundle (NEXT_PUBLIC_ prefix,
#                  Next.js inlines these at build time). Never put a secret
#                  behind this prefix.
#   SERVER-ONLY -- read only in Server Actions/Route Handlers/domain-infra;
#                  Next.js never bundles a non-NEXT_PUBLIC_ variable into
#                  client JS. Compromise of any of these is a full account-
#                  or credential-level breach -- store them only in your
#                  deployment platform's encrypted secret store, never in a
#                  file that leaves your machine.

# ---------------------------------------------------------------------------
# Supabase (PUBLIC)
# ---------------------------------------------------------------------------
# The project URL and anon (publishable) key. Safe to expose client-side --
# every table these credentials can reach is protected by Row Level
# Security; the anon key alone grants no privilege beyond what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-project-anon-key

# ---------------------------------------------------------------------------
# Supabase (SERVER-ONLY)
# ---------------------------------------------------------------------------
# Full-privilege key -- bypasses RLS entirely. Used only by domain-infra's
# service-role client (2FA secrets, account deletion, Gmail sync, MCP
# session bookkeeping, the rate-limit RPC's underlying table, etc). A leak
# of this key is equivalent to a full database compromise.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-project-service-role-key

# ---------------------------------------------------------------------------
# Encryption keys (SERVER-ONLY)
# ---------------------------------------------------------------------------
# Each of these is a 32-byte key, base64-encoded, used with AES-256-GCM to
# encrypt one specific category of secret material at rest. Generate each
# with: openssl rand -base64 32
# Use a DIFFERENT value for each of the three -- never reuse one key across
# categories, and never reuse a value across environments (dev/staging/
# production must each have their own).
TOTP_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
AI_PROVIDER_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# ---------------------------------------------------------------------------
# Gmail OAuth (SERVER-ONLY) -- Google Cloud Console credentials for the
# Gmail-financial-ingestion feature (gmail.readonly scope only).
# ---------------------------------------------------------------------------
GMAIL_OAUTH_CLIENT_ID=replace-with-your-google-cloud-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-your-google-cloud-oauth-client-secret

# ---------------------------------------------------------------------------
# Google Sign-In (Supabase Auth external provider, SERVER-ONLY) -- read
# directly by supabase/config.toml's [auth.external.google] block via
# Supabase CLI's env() substitution, NOT by any application code. A
# separate Google Cloud OAuth client from the Gmail one above -- do not
# reuse the same client for both (different consent screens, different
# redirect URIs: this one calls back to Supabase's own /auth/v1/callback,
# Gmail's calls back to this app's own /gmail/callback route).
#
# LOCAL DEV, IMPORTANT (Phase 22 forensic finding): putting these two
# lines in .env.local does NOTHING for this feature -- Supabase CLI is a
# separate process that never reads .env.local. `env(...)` in config.toml
# resolves against the shell's OS environment at the exact moment
# `supabase start` runs, and silently passes the literal "env(...)"
# string through (not an error) if the variable is unset there. To
# actually enable local Google Sign-In: `export` both variables in the
# terminal you run `supabase start`/`supabase stop && supabase start`
# from, THEN flip `enabled = true` in supabase/config.toml, then confirm
# with `docker exec supabase_auth_spencare env` (check only the LENGTH of
# GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID/_SECRET, never print the raw value)
# that it is not still holding the 44/41-character unresolved literal.
# In a real deployment (Vercel/etc.) this isn't a concern -- the platform
# injects real env vars directly into whatever process runs Supabase.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-your-google-cloud-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-your-google-cloud-oauth-client-secret

# ---------------------------------------------------------------------------
# Scheduler (SERVER-ONLY) -- Phase 21 §8. Bearer token Vercel Cron Jobs
# must present (as `Authorization: Bearer <value>`) to invoke
# /api/cron/gmail-sync. Generate with: openssl rand -hex 32
# Leaving this unset disables the scheduled sync route entirely (it
# refuses every request with HTTP 503) rather than running unauthenticated.
CRON_SECRET=replace-with-a-generated-random-secret

# ---------------------------------------------------------------------------
# Remote MCP (/api/mcp, Phase 22) -- NO new variable needed here.
# ---------------------------------------------------------------------------
# It authenticates each request from that request's own Authorization
# header (a per-user token from Settings -> MCP), and reuses this file's
# own NEXT_PUBLIC_SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above -- nothing
# new to configure. This is deliberately different from the STANDALONE
# stdio MCP server (apps/mcp-server, for local Claude-Desktop-style use),
# which needs its own SPENCARE_SUPABASE_URL/_SERVICE_ROLE_KEY/_MCP_TOKEN
# -- see apps/mcp-server/.env.example for that separate deployment.

# ---------------------------------------------------------------------------
# Anthropic / other AI providers -- NOT listed here on purpose.
# ---------------------------------------------------------------------------
# Spencare never holds a platform-wide AI provider key. Every user connects
# their OWN API key via Settings -> AI (encrypted at rest with
# AI_PROVIDER_ENCRYPTION_KEY above, in ai_provider_credentials). There is no
# ANTHROPIC_API_KEY/OPENAI_API_KEY server environment variable for this app
# to define -- if one appears in your deployment's env vars, it does not
# belong to this feature and should be investigated.
