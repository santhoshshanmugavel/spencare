# Spencare MCP server (stdio transport) -- environment reference.
#
# This is the LOCAL, per-user, Claude-Desktop-style deployment: one
# process, one user, launched by the MCP client itself (e.g. Claude
# Desktop's claude_desktop_config.json `env` block sets these). It is a
# SEPARATE deployment from apps/web's remote HTTP MCP endpoint
# (/api/mcp, Phase 22) -- that one reuses apps/web's own
# NEXT_PUBLIC_SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY and needs none of
# the variables below.
#
# All three are SERVER-ONLY -- this process never runs in a browser, so
# there is no public/private distinction to make.

# Same Supabase project apps/web points at -- deliberately a differently
# NAMED variable (not NEXT_PUBLIC_SUPABASE_URL) so a client-launch config
# for this standalone process reads unambiguously as its own thing.
SPENCARE_SUPABASE_URL=http://127.0.0.1:54321

# Same value as apps/web's SUPABASE_SERVICE_ROLE_KEY -- bypasses RLS;
# used to resolve the token below against mcp_sessions and to run every
# tool call under the resolved user's identity (never a client-supplied
# one). `npx supabase status` prints the local dev value.
SPENCARE_SUPABASE_SERVICE_ROLE_KEY=replace-with-your-project-service-role-key

# Generate one in the app: Settings -> MCP -> Generate token. Shown once,
# at creation time, in the Spencare UI -- never recoverable afterward
# (revoke and generate a new one if lost). Never commit a real value here.
SPENCARE_MCP_TOKEN=replace-with-a-token-generated-in-settings-mcp
