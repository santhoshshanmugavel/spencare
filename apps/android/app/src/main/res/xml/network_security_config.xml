<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration for the Spencare capture app.

    Allows cleartext HTTP only to the Android emulator host alias (10.0.2.2)
    and loopback addresses — the standard endpoints for a local dev server.
    A physical device accessing a real staging or production host must use HTTPS.

    All other connections require HTTPS (Android 9+ default behavior).
    This does NOT enable cleartext globally — android:usesCleartextTrafficPermitted
    in the base-config remains false.
-->
<network-security-config>
    <!-- Cleartext allowed only for known local-development hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator: 10.0.2.2 maps to the host machine's 127.0.0.1 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- Everything else requires HTTPS -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
