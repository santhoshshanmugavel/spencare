{
  "name": "@spencare/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!((jest-)?react-native|@react-native(-community)?|@react-native\\+|react-native-|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-svg))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@react-native/js-polyfills": "0.76.9",
    "@spencare/validation": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "^52.0.0",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-crypto": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "^4.0.0",
    "expo-secure-store": "^14.0.1",
    "expo-web-browser": "~14.0.2",
    "expo-status-bar": "^2.0.1",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.4.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.0",
    "jest-expo": "^52.0.6",
    "typescript": "~5.3.3"
  },
  "packageManager": "pnpm@10.20.0"
}
