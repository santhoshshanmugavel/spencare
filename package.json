{
  "name": "spencare",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "conformance": "depcruise --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "dependency-cruiser": "^16.4.2"
  },
  "pnpm": {
    "overrides": {
      "expo-router>@types/react": "~18.3.0",
      "expo>@types/react": "~18.3.0",
      "react-native>@types/react": "~18.3.0"
    },
    "packageExtensions": {
      "expo-router": {
        "dependencies": {
          "@types/react": "~18.3.0"
        }
      },
      "@react-navigation/native-stack": {
        "dependencies": {
          "@types/react": "~18.3.0"
        }
      },
      "@react-navigation/native": {
        "dependencies": {
          "@types/react": "~18.3.0"
        }
      }
    }
  }
}
